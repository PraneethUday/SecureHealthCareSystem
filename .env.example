# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# NextAuth Configuration
NEXTAUTH_URL=
NEXTAUTH_SECRET=

# Email Configuration (Nodemailer)
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_HOST=
EMAIL_PORT=

# Chat message encryption (AES-256-GCM). 64 hex chars: openssl rand -hex 32
# The server refuses to start if this is missing or malformed.
CHAT_ENCRYPTION_KEY=

# Local LLM (Ollama) for the permission-aware assistant
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_CHAT_MODEL=llama3.2
OLLAMA_EMBED_MODEL=nomic-embed-text

# Zoom Configuration (for video calls)
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=

# Application Configuration
NODE_ENV=
